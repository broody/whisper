# Uses the Sepolia pool and the public development RPC, discovery, and proving services.
# Override any WHISPER_* endpoint explicitly when needed. Omit WHISPER_NETWORK for mainnet.
WHISPER_NETWORK=sepolia
# WHISPER_RPC_URL=https://starknet-sepolia-rpc.publicnode.com
# WHISPER_DISCOVERY_MODE=contract
# WHISPER_DISCOVERY_URL=https://discovery-service.alpha-sepolia.sw-dev.io
# WHISPER_PROVING_URL=https://transaction-prover.alpha-sepolia.sw-dev.io
# WHISPER_CHAIN_ID=0x534e5f5345504f4c4941
# WHISPER_POOL_ADDRESS=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91
# WHISPER_REPLAY_TOKEN_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
WHISPER_CONTRACT_ADDRESS=replace-me
WHISPER_VAULT_ADDRESS=replace-me
WHISPER_VAULT_PUBLIC_KEY=replace-me
WHISPER_REVEAL_PUBLIC_KEY=replace-me
# Defaults to WHISPER_VAULT_PUBLIC_KEY. Override only when the auction commits
# proceeds to another registered private recipient.
# WHISPER_PROCEEDS_RECIPIENT=replace-me
# Secret-bearing JSON files are read directly by the process and must be 0600.
WHISPER_ACCOUNT_FILE=~/.starknet_accounts/whisper/sepolia_accounts.json
WHISPER_OPERATOR_SECRETS_FILE=~/.starknet_accounts/whisper/operator_secrets.json
# WHISPER_ACCOUNT_NETWORK=alpha-sepolia
# WHISPER_VAULT_ACCOUNT_NAME=whisper_sepolia_vault
# WHISPER_RELAYER_ACCOUNT_NAME=whisper_sepolia_relayer
WHISPER_DATABASE_PATH=./data/whisper-operator.sqlite
WHISPER_ALLOWED_ORIGINS=http://localhost:3000
WHISPER_DEPLOYMENT_BLOCK=replace-me
# Prove against a finalized-enough block for the pool's proof-fact acceptance window.
WHISPER_PROVING_BLOCK_LAG=10
WHISPER_API_HOST=127.0.0.1
WHISPER_API_PORT=8081
WHISPER_POLL_INTERVAL_MS=10000
