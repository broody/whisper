{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "exactOptionalPropertyTypes": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/index.ts",
    "src/fulfillment.ts",
    "src/bid-action.ts",
    "src/capsule.ts",
    "src/hashes.ts",
    "src/operator-actions.ts",
    "src/schedule.ts"
  ]
}
